// Scene editor dialogs, used by DLG_EDIT.CPP (BIRTHRT_SCENE_EDITOR):
//   IDD_EDITOR, IDD_EDIT_AI
// From the BirP project's source/NOVA95.RC (https://github.com/birthrightnet/BirP),
// which keeps the game's 1997 resource script; this repository never had it.
// Compiled into Birthrt only when CMakeLists.txt's editor option is on.
#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_EDITOR DIALOG DISCARDABLE  0, 0, 458, 279
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Avatar Editor"
FONT 8, "MS Sans Serif"
BEGIN
