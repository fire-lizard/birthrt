    LISTBOX         IDC_LIST_AI,25,168,77,51,LBS_NOINTEGRALHEIGHT |
                    WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "ADD Player Characteristics",IDC_STATIC,145,17,267,214
